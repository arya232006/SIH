# MediKiosk Backend Environment Configuration

# Choose LLM Provider: "gemini" | "groq" | "openrouter" | "huggingface" | "mock"
LLM_PROVIDER=gemini

# Google Gemini Free Tier API Key (Recommended for Vision + LLM)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq API Free Tier Key (Ultra-fast Llama inference)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter Free Tier Key (Alternative)
# Get a key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Admin Secret
ADMIN_SECRET=medikiosk_admin_secret_2026

